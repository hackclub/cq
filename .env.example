# App
PORT=3000
BASE_URL=http://localhost:3000
SESSION_COOKIE_NAME=cq_session
SESSION_DAYS=14
ORGANIZER_VERIFICATION_MINUTES=10
NODE_ENV=development
# Optional path for the local development store. Ignored when Airtable is configured.
LOCAL_DATA_PATH=./data/cq.local.json

# Hack Club Auth — create an app at https://auth.hackclub.com/developer/apps
HACKCLUB_CLIENT_ID=
HACKCLUB_CLIENT_SECRET=
HACKCLUB_REDIRECT_URI=http://localhost:3000/auth/callback

# Hackatime OAuth — create a confidential app in Hackatime → My OAuth Apps.
# The redirect URI must match this value exactly. CQ requests profile and read access.
HACKATIME_CLIENT_ID=
HACKATIME_CLIENT_SECRET=
HACKATIME_REDIRECT_URI=http://localhost:3000/app/hackatime/callback

# Set to true only for local interface testing without Hack Club credentials.
DEV_AUTH_BYPASS=false

# Airtable production database. Run `npm run airtable:setup` once before CQ.
# It creates separate readable tables named "CQ Users", "CQ Projects", etc.
AIRTABLE_PAT=
AIRTABLE_BASE_ID=
# Prefix for every CQ-owned table. Use "DEV CQ" for a development base.
AIRTABLE_TABLE_PREFIX=CQ
# Previous single-table name, used only by the safe one-way migration command.
AIRTABLE_TABLE_NAME=CQ Data

# Airtable data is not encrypted. This is used only by the encrypted local-file
# development store and to read old encrypted rows during migration.
DATA_ENCRYPTION_KEY=

# Comma-separated Hack Club emails that should receive the admin role on sign-in.
ADMIN_EMAILS=

# Slack bot notifications — bot needs the chat:write and im:write scopes.
SLACK_BOT_TOKEN=
# Optional channel for organizer-facing purchase/error notifications.
SLACK_ADMIN_CHANNEL_ID=
# Optional fallback recipient when no operations channel is configured.
# A Slack member ID (for example U012ABCDEF), not a channel ID.
SLACK_SECURITY_USER_ID=

INTERNAL_FREQUENCY_KEY_B64=

# Optional. Public GitHub repositories work without this, but a token raises
# the API rate limit for reviewers loading commit history.
GITHUB_TOKEN=

# Hack Club CDN v4 — create a server-side API key at https://cdn.hackclub.com/api_keys
# Used for participant devlog image uploads. Never expose this key in browser code.
HACKCLUB_CDN_API_KEY=

# Ari — from your program's Settings → Webhooks
ARI_PROGRAM_ID=
ARI_SIGNING_SECRET=
# Ari signs outgoing review events with this secret. It may be the same value,
# but keeping it separate makes key rotation safer.
ARI_WEBHOOK_SECRET=
