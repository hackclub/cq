<%- include('../partials/head') %>
<% const pct = (n, d) => d > 0 ? Math.round(n / d * 1000) / 10 : 0; const duration = (seconds) => seconds == null ? '—' : seconds >= 86400 ? `${Math.round(seconds / 8640) / 10}d` : seconds >= 3600 ? `${Math.round(seconds / 360) / 10}h` : `${Math.round(seconds / 60)}m`; const hours = (value) => `${Math.round(Number(value || 0) * 10) / 10}h`; const max = (rows) => Math.max(1, ...rows.map((row) => row.count)); %>
<section id="main" class="screen-page app-screen admin-screen analytics-screen">
  <header class="apphead"><div><span class="eyebrow">PROGRAM TELEMETRY</span><h1>Analytics</h1><p>Participation, project throughput, reviews, Hertz, funding, and shop activity. Dates use UTC.</p></div><nav class="analytics-ranges" aria-label="Analytics date range"><% ranges.forEach((range) => { %><a class="<%= range === days ? 'active' : '' %>" href="?days=<%= range %>"><%= range %>D</a><% }) %></nav></header>
  <div class="appbody admin-body"><%- include('nav') %>
    <% if (activityTracking.error || activityTracking.readError) { %><aside class="analytics-warning" role="status"><strong>Visitor tracking is unavailable.</strong><span>Airtable table: <%= activityTracking.tablePrefix %> Activity. <%= activityTracking.readError || activityTracking.error %></span></aside><% } %>
    <section class="analytics-section"><div class="analytics-heading"><h2>Activity</h2><p>Active participants posted a devlog. Visitors are signed-in people who opened CQ; visitor tracking starts with this release.</p></div>
      <div class="analytics-stats"><article><strong><%= analytics.activity.activeToday %></strong><span>Active today</span></article><article><strong><%= analytics.activity.avgDau %></strong><span>Average daily active</span></article><article><strong><%= analytics.activity.activeInRange %></strong><span>Active in <%= days %> days</span></article><article><strong><%= pct(analytics.activity.activeInRange, analytics.activity.totalUsers) %>%</strong><span>Active share</span></article><article><strong><%= analytics.visitors.now %></strong><span>Visitors now</span></article><article><strong><%= analytics.visitors.today %></strong><span>Visitors today</span></article><article><strong><%= analytics.visitors.inRange %></strong><span>Visitors in range</span></article><article><strong><%= analytics.visitors.avgPerDay %></strong><span>Average daily visitors</span></article></div>
      <div class="analytics-chart-grid"><div><h3>Daily active participants</h3><div class="bar-series"><% analytics.activity.perDay.forEach((point) => { %><div title="<%= point.date %>: <%= point.count %>"><i style="height:<%= Math.max(2, point.count / max(analytics.activity.perDay) * 100) %>%"></i><span><%= point.date.slice(5) %></span></div><% }) %></div></div><div><h3>Daily signed-in visitors</h3><div class="bar-series visitors"><% analytics.visitors.perDay.forEach((point) => { %><div title="<%= point.date %>: <%= point.count %>"><i style="height:<%= Math.max(2, point.count / max(analytics.visitors.perDay) * 100) %>%"></i><span><%= point.date.slice(5) %></span></div><% }) %></div></div></div>
    </section>
    <section class="analytics-section"><div class="analytics-heading"><h2>Participation and access</h2><p>Account growth, Hack Club verification, YSWS eligibility, and participant locations.</p></div><div class="analytics-stats"><article><strong><%= analytics.activity.totalUsers %></strong><span>Total participants</span></article><article><strong><%= analytics.participation.signupsInRange %></strong><span>New in <%= days %> days</span></article><article><strong><%= analytics.participation.verified %></strong><span>Verified and eligible</span></article><article><strong><%= analytics.participation.notEligible %></strong><span>Not eligible</span></article><article><strong><%= analytics.participation.organizers %></strong><span>Organizers</span></article></div><div class="analytics-chart-grid"><div><h3>Signups per day</h3><div class="bar-series"><% analytics.participation.signupsPerDay.forEach((point) => { %><div title="<%= point.date %>: <%= point.count %>"><i style="height:<%= Math.max(2, point.count / max(analytics.participation.signupsPerDay) * 100) %>%"></i><span><%= point.date.slice(5) %></span></div><% }) %></div></div><div><h3>Participant countries</h3><div class="h-bars"><% analytics.participation.countries.slice(0, 8).forEach((row) => { %><div><span><%= row.label %></span><b><i style="width:<%= pct(row.count, analytics.activity.totalUsers) %>%"></i></b><em><%= row.count %></em></div><% }) %></div></div></div></section>
    <section class="analytics-section"><div class="analytics-heading"><h2>Activation funnel</h2><p>All-time participants who reached each milestone. Steps are directional, not strictly sequential.</p></div><div class="h-bars funnel"><% analytics.funnel.forEach((row) => { %><div><span><%= row.label %></span><b><i style="width:<%= row.pctOfSignups %>%"></i></b><em><%= row.count %> · <%= row.pctOfSignups %>%</em></div><% }) %></div></section>
    <section class="analytics-section"><div class="analytics-heading"><h2>Projects and logged work</h2><p>Devlog minutes are participant-recorded work; approved hours come from completed reviews.</p></div><div class="analytics-stats"><% analytics.projects.byStatus.forEach((row) => { %><article><strong><%= row.count %></strong><span><%= statusLabel(row.status) %></span></article><% }) %><article><strong><%= analytics.projects.createdInRange %></strong><span>New projects</span></article><article><strong><%= analytics.projects.devlogsInRange %></strong><span>Devlogs in range</span></article><article><strong><%= hours(analytics.projects.loggedHoursInRange) %></strong><span>Logged in range</span></article><article><strong><%= hours(analytics.projects.totalLoggedHours) %></strong><span>Logged all time</span></article></div><div class="analytics-chart-grid"><div><h3>Submissions per day</h3><div class="bar-series"><% analytics.projects.submittedPerDay.forEach((point) => { %><div title="<%= point.date %>: <%= point.count %>"><i style="height:<%= Math.max(2, point.count / max(analytics.projects.submittedPerDay) * 100) %>%"></i><span><%= point.date.slice(5) %></span></div><% }) %></div></div><div><h3>Builders by approved hours</h3><div class="h-bars"><% [['None', analytics.projects.builderBuckets.none],['Under 5h',analytics.projects.builderBuckets.under5],['5–10h',analytics.projects.builderBuckets.from5to10],['10–25h',analytics.projects.builderBuckets.from10to25],['25h+',analytics.projects.builderBuckets.over25]].forEach(([label,count]) => { %><div><span><%= label %></span><b><i style="width:<%= pct(count, analytics.activity.totalUsers) %>%"></i></b><em><%= count %></em></div><% }) %></div></div></div></section>
    <section class="analytics-section"><div class="analytics-heading"><h2>Reviews</h2><p>Queue health and decisions made during the selected window.</p></div><div class="analytics-stats"><article><strong><%= analytics.review.pendingNow %></strong><span>Pending now</span></article><article><strong><%= duration(analytics.review.oldestPendingSeconds) %></strong><span>Oldest in queue</span></article><article><strong><%= analytics.review.submittedInRange %></strong><span>Submitted</span></article><article><strong><%= analytics.review.decidedInRange %></strong><span>Decided</span></article><article><strong><%= duration(analytics.review.avgDecisionSeconds) %></strong><span>Average decision time</span></article><article><strong><%= analytics.review.approvalRate %>%</strong><span>Approval rate</span></article><article><strong><%= analytics.review.approvedInRange %></strong><span>Approved</span></article><article><strong><%= analytics.review.changesInRange %></strong><span>Changes requested</span></article><article><strong><%= analytics.review.rejectedInRange %></strong><span>Rejected</span></article><article><strong><%= hours(analytics.review.approvedHoursInRange) %></strong><span>Approved hours</span></article></div></section>
    <section class="analytics-section"><div class="analytics-heading"><h2>Hertz economy and shop</h2><p>Credits come from approved work. Debits are non-cancelled shop orders.</p></div><div class="analytics-stats"><article><strong><%= analytics.economy.earnedInRange %></strong><span>Hertz earned</span></article><article><strong><%= analytics.economy.spentInRange %></strong><span>Hertz spent</span></article><article><strong><%= analytics.economy.earnedAll %></strong><span>Earned all time</span></article><article><strong><%= analytics.economy.spentAll %></strong><span>Spent all time</span></article><article><strong><%= analytics.economy.outstanding %></strong><span>In accounts now</span></article><article><strong><%= analytics.economy.totalOrders %></strong><span>Shop orders</span></article><article><strong><%= analytics.economy.ordersInRange %></strong><span>Orders in range</span></article><article><strong><%= analytics.economy.buyers %></strong><span>Unique buyers</span></article></div><div class="analytics-chart-grid"><div><h3>Top Hertz holders</h3><ol class="analytics-ranking"><% analytics.economy.topHolders.forEach((row) => { %><li><span><%= row.name %></span><b><%= row.balance %> Hz</b></li><% }) %></ol></div><div><h3>Shop favorites</h3><ol class="analytics-ranking"><% analytics.economy.topItems.forEach((row) => { %><li><span><%= row.name %></span><b><%= row.unitsSold %> sold · <%= row.hertzSpent %> Hz</b></li><% }) %><% if (!analytics.economy.topItems.length) { %><p class="empty-inline">No completed orders yet.</p><% } %></ol></div></div></section>
    <section class="analytics-section"><div class="analytics-heading"><h2>Funding and inventory</h2><p>Pre-build hardware funding alongside the current shop supply position.</p></div><div class="analytics-stats"><article><strong><%= analytics.funding.pending %></strong><span>Funding pending</span></article><article><strong><%= analytics.funding.approvedInRange %></strong><span>Approved in range</span></article><article><strong><%= analytics.funding.issuedAll %></strong><span>Issued all time</span></article><article><strong><%= analytics.funding.requestedHertz %></strong><span>Hertz requested</span></article><article><strong><%= analytics.funding.approvedHertz %></strong><span>Hertz approved</span></article><article><strong><%= analytics.inventory.activeProducts %></strong><span>Active shop items</span></article><article><strong><%= analytics.inventory.unitsInStock %></strong><span>Units in stock</span></article><article><strong><%= analytics.inventory.lowStock %></strong><span>Low-stock items</span></article></div></section>
  </div>
</section>
<%- include('../partials/footer') %>
