<%- include('../partials/head') %>
<main class="admin-shell"><header class="apphead"><div><p class="eyebrow">ORGANIZER / SETTINGS</p><h1>Settings</h1></div></header><%- include('nav') %>
<section class="panel form-stack"><h2>Homepage launch gate</h2><p>Hide sign-in controls while production setup is in progress.</p><form method="post" action="/admin/settings"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label><input type="checkbox" name="launch_gate" <%= launchGate.enabled ? 'checked' : '' %>> Show coming-soon mode</label><label>Message<input name="message" maxlength="120" value="<%= launchGate.message %>"></label><label>Optional launch date/time<input name="until" maxlength="80" value="<%= launchGate.until %>"></label><button class="button button-primary" type="submit">Save setting</button></form></section></main><%- include('../partials/footer') %>
