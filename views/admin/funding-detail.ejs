<%- include('../partials/head') %>
<section id="main" class="screen-page app-screen admin-screen">
  <header class="apphead"><div><span class="eyebrow">FUNDING / <%= request.id %></span><h1><%= project?.title || request.projectId %></h1></div><div class="headright"><a class="button button-ghost" href="/admin/funding">Back to funding</a><a class="button button-primary" href="<%= request.designUrl %>" target="_blank" rel="noreferrer">Open design ↗</a></div></header>
  <div class="appbody admin-body"><%- include('nav') %><div class="review-workspace"><div class="project-main-column">
    <section class="panel"><div class="panel-heading"><div><p class="eyebrow">Request</p><h2>Build and funding plan</h2></div><span class="status-pill status-<%= request.status %>"><%= statusLabel(request.status) %></span></div><dl class="admin-detail-list"><div><dt>Maker</dt><dd><%= maker?.name || 'Unknown' %> · <%= maker?.email || '' %></dd></div><div><dt>Estimate</dt><dd><strong><%= request.estimatedHours %> hours</strong> at 5 Hertz/hour</dd></div><div><dt>Requested</dt><dd><strong><%= request.requestedHertz %> hertz</strong></dd></div><div><dt>Design</dt><dd><a href="<%= request.designUrl %>" target="_blank" rel="noreferrer"><%= request.designUrl %> ↗</a></dd></div></dl></section>
    <section class="panel"><div class="panel-heading"><h2>Build plan</h2></div><div class="markdown-body"><%= request.buildPlan %></div></section>
    <section class="panel"><div class="panel-heading"><h2>Bill of materials</h2></div><pre class="audit-json"><%= request.bom %></pre></section>
    <section class="panel"><div class="panel-heading"><h2>Test plan</h2></div><div class="markdown-body"><%= request.testPlan %></div></section>
    <% if (actions.length) { %><section class="panel"><div class="panel-heading"><h2>Decision history</h2></div><div class="compact-list"><% actions.forEach((action) => { %><div><span><strong><%= action.reviewerName %> · <%= statusLabel(action.action) %></strong><small><%= action.noteToMaker || action.internalNote || '' %></small></span><time><%= formatDateTime(action.createdAt) %></time></div><% }) %></div></section><% } %>
  </div><aside class="project-sidebar">
    <% if (['submitted', 'under_review', 'changes_requested'].includes(request.status)) { %><form method="post" action="/admin/funding/<%= request.id %>/decision" class="panel form-stack review-decision-form"><div><p class="eyebrow">Funding decision</p><h2>Review request</h2></div><label>Decision<select name="decision" required><option value="">Choose…</option><option value="approved">Approve funding</option><option value="changes">Return for changes</option><option value="rejected">Decline</option></select></label><fieldset class="review-checklist"><legend>Checks</legend><label><input type="checkbox" name="design_checked" value="1"> The design is feasible and relevant</label><label><input type="checkbox" name="bom_checked" value="1"> The BOM and supplier links are sensible</label><label><input type="checkbox" name="plan_checked" value="1"> The build and test plan are clear</label></fieldset><label>Approved funding<input type="number" name="approved_hertz" min="0" max="<%= request.requestedHertz %>" step="0.01" value="<%= request.requestedHertz %>"><small>Cannot exceed the requested <%= request.requestedHertz %> Hertz.</small></label><label>Message to participant<textarea name="note_to_maker" rows="5" maxlength="3000"></textarea></label><label>Private notes<textarea name="internal_note" rows="4" maxlength="3000"></textarea></label><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-primary" type="submit">Save funding decision</button></form><% } %>
    <% if (request.status === 'approved') { %><form method="post" action="/admin/funding/<%= request.id %>/issue" class="panel form-stack"><p class="eyebrow">HCB handoff</p><h2>Mark funding issued</h2><label>HCB grant reference / optional<input name="hcb_grant_reference" maxlength="200" placeholder="Grant URL or ID"></label><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-primary" type="submit">Mark issued</button></form><% } %>
    <% if (request.status === 'issued') { %><section class="panel compact-panel"><p class="eyebrow">Funding issued</p><strong><%= request.review?.approvedHertz %> hertz</strong><p><%= formatDateTime(request.issuedAt) %><% if (request.hcbGrantReference) { %><br><%= request.hcbGrantReference %><% } %></p></section><% } %>
  </aside></div></div>
</section>
<%- include('../partials/footer') %>
