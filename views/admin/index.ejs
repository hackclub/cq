<%- include('../partials/head') %>
<main id="main" class="app-main shell">
  <div class="page-heading"><div><p class="eyebrow">Organizer frequency</p><h1>Organizer dashboard</h1><p>Your permitted tools for project review, fulfilment, content, and program operations.</p></div><span class="status-pill status-approved"><%= reviewMode %> active</span></div>
  <%- include('nav') %>
  <section class="metric-grid admin-metrics"><% if (hasPermission(user, 'users.manage')) { %><article><span>Participants</span><strong><%= stats.users %></strong></article><% } %><% if (hasPermission(user, 'projects.review')) { %><article><span>Active projects</span><strong><%= stats.activeProjects %></strong></article><article><span>Pending reviews</span><strong><%= stats.pendingReviews %></strong></article><% } %><% if (hasPermission(user, 'orders.manage')) { %><article><span>Open orders</span><strong><%= stats.openOrders %></strong></article><% } %></section>
  <div class="admin-grid">
    <% if (hasPermission(user, 'projects.review')) { %><section class="panel"><div class="panel-heading"><h2>Recent projects</h2><a href="/admin/reviews">Review queue</a></div><div class="compact-list"><% recentProjects.forEach((item) => { %><a href="/admin/projects/<%= item.id %>"><span><strong><%= item.title %></strong><small><%= formatDate(item.updatedAt) %></small></span><span class="status-pill status-<%= item.status %>"><%= statusLabel(item.status) %></span></a><% }) %></div></section><% } %>
    <% if (hasPermission(user, 'orders.manage')) { %><section class="panel"><div class="panel-heading"><h2>Fulfilment queue</h2><a href="/admin/orders">Manage</a></div><div class="compact-list"><% recentOrders.forEach((item) => { %><a href="/admin/orders"><span><strong><%= item.id %></strong><small><%= item.total %> hertz</small></span><span class="status-pill status-<%= item.status %>"><%= statusLabel(item.status) %></span></a><% }) %></div></section><% } %>
    <% if (hasPermission(user, 'users.manage')) { %><section class="panel"><div class="panel-heading"><h2>Review deliveries</h2><a href="/admin/reviews">Inspect</a></div><div class="compact-list"><% deliveries.forEach((item) => { %><div><span><strong><%= item.event %></strong><small><%= item.id %></small></span><time><%= formatDateTime(item.receivedAt) %></time></div><% }) %></div></section><% } %>
    <% if (hasPermission(user, 'shop.manage')) { %><section class="panel"><div class="panel-heading"><h2>Low stock</h2><a href="/admin/shop">Inventory</a></div><div class="compact-list"><% if (!lowStock.length) { %><p class="empty-inline">Stock levels look healthy.</p><% } %><% lowStock.forEach((item) => { %><div><span><strong><%= item.name %></strong><small><%= item.category %></small></span><b><%= item.stock %> left</b></div><% }) %></div></section><% } %>
  </div>
</main>
<%- include('../partials/footer') %>
