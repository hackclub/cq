<%- include('../partials/head') %>
<section id="main" class="screen-page app-screen admin-screen">
  <header class="apphead"><div><span class="eyebrow">ORGANIZER FREQUENCY</span><h1>Organizer dashboard</h1></div><span class="tag headright"><%= reviewMode %> active</span></header>
  <div class="appbody admin-body">
  <%- include('nav') %>
  <section class="metric-grid admin-metrics"><% if (hasPermission(user, 'users.manage')) { %><article><span>Participants</span><strong><%= stats.users %></strong></article><% } %><% if (hasPermission(user, 'projects.review')) { %><article><span>Active projects</span><strong><%= stats.activeProjects %></strong></article><article><span>Final reviews</span><strong><%= stats.pendingReviews %></strong></article><article><span>Funding requests</span><strong><%= stats.pendingFunding %></strong></article><% } %><% if (hasPermission(user, 'orders.manage')) { %><article><span>Open orders</span><strong><%= stats.openOrders %></strong></article><% } %></section>
  <div class="admin-grid">
    <% if (hasPermission(user, 'projects.review')) { %><section class="panel"><div class="panel-heading"><h2>Recent projects</h2><a href="/admin/reviews">Final reviews</a></div><div class="compact-list"><% recentProjects.forEach((item) => { %><a href="/admin/projects/<%= item.id %>"><span><strong><%= item.title %></strong><small><%= formatDate(item.updatedAt) %></small></span><span class="status-pill status-<%= item.status %>"><%= statusLabel(item.status) %></span></a><% }) %></div></section><section class="panel"><div class="panel-heading"><h2>Hardware funding</h2><a href="/admin/funding">Review requests</a></div><p class="empty-inline">Funding is reviewed before a hardware build starts. Issuing funding never adds to the participant’s Hertz balance.</p></section><% } %>
    <% if (hasPermission(user, 'orders.manage')) { %><section class="panel"><div class="panel-heading"><h2>Fulfilment queue</h2><a href="/admin/orders">Manage</a></div><div class="compact-list"><% recentOrders.forEach((item) => { %><a href="/admin/orders"><span><strong><%= item.id %></strong><small><%= item.total %> hertz</small></span><span class="status-pill status-<%= item.status %>"><%= statusLabel(item.status) %></span></a><% }) %></div></section><% } %>
    <% if (hasPermission(user, 'users.manage')) { %><section class="panel"><div class="panel-heading"><h2>Review deliveries</h2><a href="/admin/reviews">Inspect</a></div><div class="compact-list"><% deliveries.forEach((item) => { %><div><span><strong><%= item.event %></strong><small><%= item.id %></small></span><time><%= formatDateTime(item.receivedAt) %></time></div><% }) %></div></section><% } %>
    <% if (hasPermission(user, 'shop.manage')) { %><section class="panel"><div class="panel-heading"><h2>Low stock</h2><a href="/admin/shop">Inventory</a></div><div class="compact-list"><% if (!lowStock.length) { %><p class="empty-inline">Stock levels look healthy.</p><% } %><% lowStock.forEach((item) => { %><div><span><strong><%= item.name %></strong><small><%= item.category %></small></span><b><%= item.stock %> left</b></div><% }) %></div></section><% } %>
  </div>
  </div>
</section>
<%- include('../partials/footer') %>
