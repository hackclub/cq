<%- include('../partials/head') %>
<main id="main" class="app-main shell">
  <div class="page-heading"><div><p class="eyebrow">Organizer frequency</p><h1>Admin dashboard</h1><p>Participants, builds, reviews, fulfilment, and encrypted storage health.</p></div><span class="status-pill <%= ariConfigured ? 'status-approved' : 'status-rejected' %>">Ari <%= ariConfigured ? 'connected' : 'not configured' %></span></div>
  <%- include('nav') %>
  <section class="metric-grid admin-metrics"><article><span>Participants</span><strong><%= stats.users %></strong></article><article><span>Active projects</span><strong><%= stats.activeProjects %></strong></article><article><span>Pending Ari reviews</span><strong><%= stats.pendingReviews %></strong></article><article><span>Open orders</span><strong><%= stats.openOrders %></strong></article></section>
  <div class="admin-grid">
    <section class="panel"><div class="panel-heading"><h2>Recent projects</h2><a href="/admin/projects">Manage</a></div><div class="compact-list"><% recentProjects.forEach((item) => { %><a href="<%= item.repoUrl %>" target="_blank" rel="noreferrer"><span><strong><%= item.title %> ↗</strong><small><%= formatDate(item.updatedAt) %></small></span><span class="status-pill status-<%= item.status %>"><%= statusLabel(item.status) %></span></a><% }) %></div></section>
    <section class="panel"><div class="panel-heading"><h2>Fulfilment queue</h2><a href="/admin/orders">Manage</a></div><div class="compact-list"><% recentOrders.forEach((item) => { %><a href="/admin/orders"><span><strong><%= item.id %></strong><small><%= item.total %> hertz</small></span><span class="status-pill status-<%= item.status %>"><%= statusLabel(item.status) %></span></a><% }) %></div></section>
    <section class="panel"><div class="panel-heading"><h2>Ari deliveries</h2><a href="/admin/reviews">Inspect</a></div><div class="compact-list"><% deliveries.forEach((item) => { %><div><span><strong><%= item.event %></strong><small><%= item.id %></small></span><time><%= formatDateTime(item.receivedAt) %></time></div><% }) %></div></section>
    <section class="panel"><div class="panel-heading"><h2>Low stock</h2><a href="/admin/shop">Inventory</a></div><div class="compact-list"><% if (!lowStock.length) { %><p class="empty-inline">Stock levels look healthy.</p><% } %><% lowStock.forEach((item) => { %><div><span><strong><%= item.name %></strong><small><%= item.category %></small></span><b><%= item.stock %> left</b></div><% }) %></div></section>
  </div>
</main>
<%- include('../partials/footer') %>
