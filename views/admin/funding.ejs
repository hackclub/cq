<%- include('../partials/head') %>
<section id="main" class="screen-page app-screen admin-screen">
  <header class="apphead"><div><span class="eyebrow">ORGANIZER / HARDWARE</span><h1>Funding requests</h1></div><div class="headright"><span class="tag"><%= requests.filter((item) => ['submitted', 'under_review'].includes(item.status)).length %> waiting</span></div></header>
  <div class="appbody admin-body"><%- include('nav') %>
    <section class="metric-grid admin-metrics"><article><span>Generated value</span><strong>$<%= fundingSummary.generatedUsd.toFixed(2) %></strong></article><article><span>Grant allocations</span><strong>$<%= fundingSummary.allocatedUsd.toFixed(2) %></strong></article><article><span>Prize capacity</span><strong>$<%= fundingSummary.availableUsd.toFixed(2) %></strong></article></section>
    <section class="panel table-wrap"><table><thead><tr><th>Project</th><th>Maker</th><th>Estimate</th><th>Requested</th><th>Status</th><th>Updated</th><th></th></tr></thead><tbody>
      <% requests.forEach((item) => { %><tr><td><strong><%= item.project?.title || item.projectId %></strong><small><%= item.project?.projectType || 'hardware' %></small></td><td><%= item.maker?.name || 'Unknown' %><small><%= item.maker?.email || '' %></small></td><td><%= item.designMinutes || 0 %> documented min</td><td><strong>$<%= Number(item.requestedUsd ?? item.requestedHertz ?? 0).toFixed(2) %> USD</strong></td><td><span class="status-pill status-<%= item.status %>"><%= statusLabel(item.status) %></span></td><td><%= formatDateTime(item.updatedAt) %></td><td><a class="button button-small" href="/admin/funding/<%= item.id %>"><%= item.status === 'submitted' ? 'Review' : 'Inspect' %></a></td></tr><% }) %>
      <% if (!requests.length) { %><tr><td colspan="7" class="empty-inline">No hardware funding requests yet.</td></tr><% } %>
    </tbody></table></section>
    <section class="panel table-wrap"><div class="panel-heading"><h2>Program-funding ledger</h2><strong><%= ledger.length %> entries</strong></div><table><thead><tr><th>Source</th><th>Status</th><th>Generated</th><th>Allocated</th><th>Available</th><th>Updated</th></tr></thead><tbody><% ledger.forEach((entry) => { %><tr><td><strong><%= statusLabel(entry.type) %></strong><small><%= entry.projectId || entry.sourceId %></small></td><td><span class="status-pill status-<%= entry.status %>"><%= statusLabel(entry.status) %></span></td><td>$<%= Number(entry.generatedUsd || 0).toFixed(2) %></td><td>$<%= Number(entry.allocatedUsd || 0).toFixed(2) %></td><td>$<%= Number(entry.availableUsd || 0).toFixed(2) %></td><td><%= formatDateTime(entry.updatedAt) %></td></tr><% }) %><% if (!ledger.length) { %><tr><td colspan="6" class="empty-inline">No approved hours or grant allocations yet.</td></tr><% } %></tbody></table></section>
  </div>
</section>
<%- include('../partials/footer') %>
