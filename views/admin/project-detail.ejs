<%- include('../partials/head') %>
<section id="main" class="screen-page app-screen admin-screen">
  <header class="apphead">
    <div>
      <span class="eyebrow">PROJECT / <%= project.id %> / <%= statusLabel(project.status) %></span>
      <h1><%= project.title %></h1>
    </div>
    <div class="headright"><a class="button button-ghost" href="/admin/projects">All projects</a><a class="button button-primary" href="<%= project.repoUrl %>" target="_blank" rel="noreferrer">Repository ↗</a></div>
  </header>
  <div class="appbody admin-body"><%- include('nav') %>

  <div class="project-layout">
    <div class="project-main-column">
      <section class="panel">
        <div class="panel-heading"><h2>Eligibility and evidence</h2></div>
        <dl class="admin-detail-list">
          <div><dt>Project type</dt><dd><%= statusLabel(project.projectType) %></dd></div>
          <div><dt>Ham-radio relevance</dt><dd><%= project.radioRelevance %></dd></div>
          <div><dt>Work tracking</dt><dd><%= project.hackatimeProjects.join(', ') || 'Manual work logs' %></dd></div>
          <div><dt>Evidence</dt><dd><%= project.evidence.join(', ') %></dd></div>
          <div><dt>Demo</dt><dd><% if (project.demoUrl) { %><a href="<%= project.demoUrl %>" target="_blank" rel="noreferrer">Open demo ↗</a><% } else { %>Not supplied<% } %></dd></div>
          <div><dt>AI statement</dt><dd><%= project.aiStatement || 'None supplied' %></dd></div>
        </dl>
      </section>

      <% if (project.track === 'software') { const diagnosticStatus = { current: 'Current', stale: 'Stale cache', reconnect: 'Reconnect needed', unavailable: 'Unavailable', disconnected: 'Disconnected', 'not-linked': 'Not linked' }[hackatimeDiagnostics.status] || statusLabel(hackatimeDiagnostics.status); %>
      <section class="panel hackatime-diagnostics">
        <div class="panel-heading"><div><h2>Hackatime diagnostics</h2><p>How CQ derives the next devlog duration.</p></div><span class="diagnostic-state <%= hackatimeDiagnostics.status %>"><%= diagnosticStatus %></span></div>
        <dl class="diagnostic-summary">
          <div><dt>Account</dt><dd><%= hackatimeDiagnostics.account?.username || 'Not available' %></dd></div>
          <div><dt>Cache fetched</dt><dd><%= hackatimeDiagnostics.fetchedAt ? formatDateTime(hackatimeDiagnostics.fetchedAt) : 'Never' %></dd></div>
          <div><dt>Selection changed</dt><dd><%= hackatimeDiagnostics.selectionUpdatedAt ? formatDateTime(hackatimeDiagnostics.selectionUpdatedAt) : 'Not recorded' %></dd></div>
          <div><dt>CQ-calculated unlogged</dt><dd><strong><%= hackatimeDiagnostics.unloggedLabel %></strong></dd></div>
        </dl>
        <% if (hackatimeDiagnostics.projects.length) { %>
        <div class="table-wrap diagnostic-table"><table><thead><tr><th>Linked project</th><th>Link baseline</th><th>Last claimed snapshot</th><th>Hackatime total</th><th>Unlogged delta</th><th>Latest heartbeat</th></tr></thead><tbody>
          <% hackatimeDiagnostics.projects.forEach((item) => { %><tr><td><strong><%= item.name %></strong><% if (item.languages.length) { %><small><%= item.languages.join(', ') %></small><% } %></td><td><%= item.baselineLabel %></td><td><%= item.comparisonLabel %></td><td><%= item.currentLabel %></td><td><strong><%= item.unloggedLabel %></strong></td><td><%= item.mostRecentHeartbeat ? formatDateTime(item.mostRecentHeartbeat) : 'Not available' %></td></tr><% }) %>
        </tbody></table></div>
        <p class="diagnostic-source">The comparison starts at <%= hackatimeDiagnostics.comparisonJournal ? `the saved snapshot from “${hackatimeDiagnostics.comparisonJournal.title || 'Project update'}”` : 'the baseline captured when the project was linked' %>.</p>
        <details class="diagnostic-history"><summary>Change tracking start</summary><p class="diagnostic-source">Set the Hackatime total that should count as zero for CQ. Changing it recalculates the first saved devlog; later devlogs keep their snapshot-to-snapshot durations.</p><div class="form-stack"><% hackatimeDiagnostics.projects.forEach((item) => { %><form method="post" action="/admin/projects/<%= project.id %>/hackatime-start" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="project_name" value="<%= item.name %>"><strong><%= item.name %></strong><label>Hackatime total at tracking start (minutes)<input type="number" name="baseline_minutes" min="0" max="100000" step="0.01" value="<%= item.baselineMinutes %>" required></label><label>Reason<textarea name="reason" rows="2" maxlength="2000" required placeholder="Why should CQ start counting earlier or later?"></textarea></label><button class="button button-ghost" type="submit">Update tracking start</button></form><% }) %></div></details>
        <% } else { %><p class="empty-inline">No Hackatime projects are linked to this CQ project.</p><% } %>
        <details class="diagnostic-history"><summary>Saved devlog snapshots <span><%= hackatimeDiagnostics.snapshots.length %></span></summary>
          <% if (hackatimeDiagnostics.snapshots.length) { %><div class="table-wrap diagnostic-table"><table><thead><tr><th>Devlog</th><th>Date</th><th>Claimed</th><th>Saved totals</th></tr></thead><tbody><% hackatimeDiagnostics.snapshots.forEach((snapshot) => { %><tr><td><%= snapshot.title %></td><td><%= formatDate(snapshot.entryDate) %></td><td><%= snapshot.minutes %> min</td><td><% snapshot.values.forEach((value) => { %><span class="snapshot-value"><%= value.name %>: <strong><%= value.label %></strong></span><% }) %></td></tr><% }) %></tbody></table></div><% } else { %><p class="empty-inline">No Hackatime snapshots have been saved in a devlog yet.</p><% } %>
        </details>
      </section>
      <% } %>

      <section class="panel">
        <div class="panel-heading"><h2>Devlog</h2><strong><%= Math.round(journals.reduce((sum, item) => sum + item.minutes, 0) / 6) / 10 %> hours</strong></div>
        <% if (!journals.length) { %><p class="empty-inline">No devlogs.</p><% } %>
        <div class="journal-list"><% journals.forEach((journal) => { const images = (journal.imageUrls?.length ? journal.imageUrls : (journal.imageUrl ? [journal.imageUrl] : [])).filter((url) => String(url || "").match(/^https?:\/\//i)); %><article><header><div><h3><%= journal.title || 'Project update' %></h3><% if (journal.manualAdjustmentMinutes) { %><small><%= journal.manualAdjustmentMinutes %> min manually added</small><% } %><% if (journal.hackatimeBaselineAdjustmentMinutes) { %><small><%= journal.hackatimeBaselineAdjustmentMinutes > 0 ? '+' : '' %><%= journal.hackatimeBaselineAdjustmentMinutes %> min from tracking-start corrections</small><% } %></div><div class="devlog-meta"><time><%= formatDate(journal.entryDate) %></time><strong><%= journal.minutes %> min</strong></div></header><div class="devlog-body markdown-body"><%- renderMarkdown(journal.text) %></div><% if (journal.manualTimeAdjustments?.length) { %><details class="diagnostic-history"><summary>Manual time adjustments <span><%= journal.manualTimeAdjustments.length %></span></summary><dl class="admin-detail-list"><% journal.manualTimeAdjustments.forEach((adjustment) => { %><div><dt>+<%= adjustment.minutes %> min · <%= adjustment.addedByName || 'Organizer' %></dt><dd><%= adjustment.reason %></dd></div><% }) %></dl></details><% } %><% if (images.length) { %><div class="devlog-gallery <%= images.length === 1 ? 'single' : '' %>"><% images.forEach((imageUrl) => { %><a class="journal-image" href="<%= imageUrl %>" target="_blank" rel="noreferrer"><img src="<%= imageUrl %>" alt="Progress evidence" loading="lazy" referrerpolicy="no-referrer"></a><% }) %></div><% } else { %><div class="missing-journal-image">Image missing</div><% } %></article><% }) %></div>
      </section>

      <section class="panel table-wrap">
        <div class="panel-heading"><h2>Review history</h2></div>
        <table><thead><tr><th>ID</th><th>Phase</th><th>Decision</th><th>Event</th><th>Updated</th></tr></thead><tbody><% submissions.forEach((item) => { %><tr><td><%= item.ariId || item.id %></td><td><%= statusLabel(item.phase) %></td><td><%= item.decision ? statusLabel(item.decision) : 'Pending' %></td><td><%= item.event || '—' %></td><td><%= formatDateTime(item.updatedAt) %></td></tr><% }) %></tbody></table>
      </section>
    </div>

    <aside class="project-sidebar">
      <section class="panel compact-panel"><p class="eyebrow">Maker</p><strong><%= maker?.name || 'Unknown' %></strong><p><%= maker?.email || '' %><br><%= maker?.slackId || 'No Slack ID' %></p></section>
      <section class="panel compact-panel"><p class="eyebrow">Radio path</p><dl><div><dt>Licence goal</dt><dd><%= project.licenseGoal || 'Not set' %></dd></div><div><dt>Callsign</dt><dd><%= project.callsign || 'Not issued' %></dd></div></dl></section>
      <% if (country) { %><section class="panel compact-panel"><p class="eyebrow">Fulfilment</p><strong><%= statusLabel(country.fulfilmentMode) %></strong><p><%= country.fulfilmentNote %></p></section><% } %>
      <% if (submissions[0]) { %><a class="button button-primary" href="/admin/reviews/<%= submissions[0].id %>">Open latest review</a><% } %>
      <% if (journals.length) { %><form method="post" action="/admin/projects/<%= project.id %>/time-adjustments" class="panel form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h2>Add missing time</h2><p>Credit work that Hackatime missed without changing its saved totals.</p><label>Devlog<select name="journal_id" required><% journals.forEach((journal) => { %><option value="<%= journal.id %>"><%= journal.title || 'Project update' %> · <%= journal.minutes %> min</option><% }) %></select></label><label>Minutes<input type="number" name="minutes" min="1" max="1440" step="1" required></label><label>Reason<textarea name="reason" rows="3" maxlength="2000" required placeholder="What work was missed, and how was it verified?"></textarea></label><button class="button button-primary" type="submit">Add time</button></form><% } %>
      <% if (project.status === 'rejected') { %><form method="post" action="/admin/projects/<%= project.id %>" class="panel form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="building"><p class="eyebrow">Reopen project</p><p>Return this project to the maker so they can make changes and ship a new review.</p><button class="button button-primary" type="submit">Reopen for changes</button></form><% } %>
      <form method="post" action="/admin/projects/<%= project.id %>" class="panel form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="<%= project.status === 'archived' ? 'building' : 'archived' %>"><button class="button button-ghost" type="submit"><%= project.status === 'archived' ? 'Restore project' : 'Archive project' %></button><small>Approval, changes, and denial decisions are made through the review queue.</small></form>
    </aside>
  </div>
  </div>
</section>
<%- include('../partials/footer') %>
