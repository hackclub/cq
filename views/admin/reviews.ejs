<%- include('../partials/head') %>
<main id="main" class="app-main shell">
  <div class="page-heading"><div><p class="eyebrow">Organizer review</p><h1>Project review queue</h1><p>Claim a submission, inspect its devlogs, code, and claimed time, then record the decision.</p></div><span class="status-pill status-approved"><%= reviewMode %> active</span></div>
  <%- include('nav') %>
  <section class="panel table-wrap">
    <table><thead><tr><th>Project</th><th>Maker</th><th>Claimed time</th><th>Reviewer</th><th>Status</th><th>Updated</th><th></th></tr></thead><tbody>
      <% submissions.forEach((item) => { %><tr><td><strong><%= item.project?.title || item.projectId %></strong><small><%= item.devlogCount %> devlog<%= item.devlogCount === 1 ? '' : 's' %></small></td><td><%= item.maker?.name || 'Unknown' %><small><%= item.maker?.email || '' %></small></td><td><strong><%= Math.round((item.claimedMinutes / 60) * 100) / 100 %> hr</strong><small><%= item.claimedMinutes %> minutes</small></td><td><%= item.reviewer?.name || 'Unclaimed' %></td><td><span class="status-pill status-<%= item.decision || item.phase %>"><%= item.decision ? statusLabel(item.decision) : statusLabel(item.phase) %></span></td><td><%= formatDateTime(item.updatedAt) %></td><td><a class="button button-small" href="/admin/reviews/<%= item.id %>"><%= item.decision ? 'Inspect' : 'Review' %></a></td></tr><% }) %>
    </tbody></table>
  </section>
  <% if (hasPermission(user, 'users.manage')) { %><section class="panel table-wrap">
    <div class="panel-heading"><h2>Webhook deliveries</h2></div>
    <table><thead><tr><th>Delivery ID</th><th>Event</th><th>External ID</th><th>Received</th></tr></thead><tbody>
      <% deliveries.forEach((item) => { %><tr><td><code><%= item.id %></code></td><td><%= item.event %></td><td><%= item.payload.external_id %></td><td><%= formatDateTime(item.receivedAt) %></td></tr><% }) %>
    </tbody></table>
  </section><% } %>
</main>
<%- include('../partials/footer') %>
