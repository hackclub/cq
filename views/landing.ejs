<%- include('partials/head') %>
<section class="page home active" data-page="home">
  <div class="scope">
    <canvas id="scopeCanvas"></canvas>
    <div class="freq" id="frequency">145.990.000 <small>MHz / FM</small></div>
    <div class="scale">
      <span>145.960</span>
      <span>145.975</span>
      <span>145.990</span>
      <span>146.005</span>
      <span>146.020</span>
    </div>
    <div class="rxlog">
      <span>MODE FM / FILTER 12.5K / SQL 018</span>
      <span>SIGNAL SOURCE: CQ / HACK CLUB</span>
    </div>
  </div>

  <div class="homecopy">
    <p class="eyebrow">CQ CQ CQ DE HACK CLUB</p>
    <h1>Build your way onto the air.</h1>
    <p>Build amateur-radio projects, log your work, and earn real equipment. No previous radio experience needed.</p>
    <% if (launchGate) { %><div class="launch-gate"><strong><%= launchGate.message || 'Coming soon' %></strong><% if (launchGate.until) { %><span>Launches <%= launchGate.until %></span><% } %></div><% } else { %><div class="actions">
      <a href="/auth/login" class="button" data-go="station">TUNE IN</a>
      <button class="button ghost" data-modal="about">PROGRAM INFO</button>
    </div><% } %>
    <p class="sponsor-credit">SPONSORED BY ARCADE W</p>
  </div>
</section>

<%- include('partials/footer') %>
