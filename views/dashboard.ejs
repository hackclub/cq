<%- include('partials/head') %>
<main id="main" class="app-main shell">
  <section class="dashboard-hero">
    <div>
      <p class="eyebrow">Your station</p>
      <h1>Good to hear you, <%= user.name.split(' ')[0] %>.</h1>
      <p>Keep the signal moving: plan, build, document, and ship.</p>
    </div>
    <a class="button button-light" href="/app/projects/new">+ New project</a>
  </section>

  <section class="metric-grid">
    <article><span>Hertz balance</span><strong><%= user.hertz %></strong><a href="/app/shop">Open shop →</a></article>
    <article><span>Projects on air</span><strong><%= stats.projectCount || 0 %></strong><a href="/app/projects">Manage projects →</a></article>
    <article><span>Approved projects</span><strong><%= stats.approvedCount || 0 %></strong><span class="muted">5 hertz per approved hour</span></article>
  </section>

  <section class="panel">
    <div class="panel-heading">
      <div><p class="eyebrow">Active signals</p><h2>Your projects</h2></div>
      <a href="/app/projects">View all</a>
    </div>
    <% if (!projects.length) { %>
      <div class="empty-state"><img src="/assets/sattelite.png" alt=""><h3>No projects transmitting yet.</h3><p>Your first project could be an antenna, radio circuit, SDR experiment, digital mode, or ham-radio software tool.</p><a class="button button-primary" href="/app/projects/new">Create your first project</a></div>
    <% } else { %>
      <div class="project-list">
        <% projects.forEach((project) => { %>
          <a class="project-row" href="/app/projects/<%= project.id %>">
            <span class="status-dot status-<%= project.status %>"></span>
            <div><strong><%= project.title %></strong><span><%= project.description %></span></div>
            <div class="project-row-meta"><span><%= project.milestonesDone %>/<%= project.milestonesTotal %> milestones</span><span><%= Math.round(project.journalMinutes / 60 * 10) / 10 %>h logged</span></div>
            <span class="status-pill status-<%= project.status %>"><%= statusLabel(project.status) %></span>
          </a>
        <% }) %>
      </div>
    <% } %>
  </section>

  <% if (latestOrder) { %>
    <section class="panel slim-panel">
      <div><p class="eyebrow">Latest order</p><h2><%= latestOrder.id %></h2><p><%= formatDate(latestOrder.createdAt) %> · <%= latestOrder.total %> hertz · <%= statusLabel(latestOrder.status) %></p></div>
      <a class="button button-ghost" href="/app/shop/orders/<%= latestOrder.id %>">View order</a>
    </section>
  <% } %>
</main>
<%- include('partials/footer') %>
