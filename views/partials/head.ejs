<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#353636">
  <meta name="description" content="Build ham-radio electronics or software, document the work, and earn gear through Hack Club.">
  <meta property="og:title" content="CQ — get on the air">
  <meta property="og:description" content="Make ham-radio hardware or software, submit it for review, and earn radio gear with Hack Club.">
  <meta property="og:type" content="website">
  <title><%= title %> · CQ</title>
  <link rel="stylesheet" href="/app.css">
</head>
<body class="<%= [typeof bodyClass === 'string' ? bodyClass : '', organizerWarningRequired ? 'organizer-unverified' : ''].filter(Boolean).join(' ') %>">
  <a class="skip-link" href="#main">Skip to content</a>
  <% const channel = currentPath === '/' ? ['145.990.000', 'VFO A / PUBLIC'] : currentPath === '/app' ? ['005.000', 'MEM 02 / STATION'] : currentPath.startsWith('/app/projects') ? ['005.100', 'MEM 03 / PROJECTS'] : currentPath.startsWith('/app/shop/orders') ? ['437.802.000', 'MEM 05 / ORDERS'] : currentPath.startsWith('/app/shop') ? ['437.800.000', 'MEM 04 / SHOP'] : currentPath.startsWith('/app/profile') ? ['144.390.000', 'MEM 06 / PROFILE'] : currentPath.startsWith('/admin') ? ['001.100', 'CONTROL / ORGANIZER'] : ['145.990.000', 'CQ / INFO']; %>
  <div class="desk">
    <section class="radio">
      <i class="screw tl" aria-hidden="true"></i><i class="screw tr" aria-hidden="true"></i><i class="screw bl" aria-hidden="true"></i><i class="screw br" aria-hidden="true"></i>
      <header class="top">
        <a class="radio-logo" href="<%= user ? '/app' : '/' %>"><b>CQ</b><span>/ HC-03</span></a>
        <span class="top-model">SOFTWARE DEFINED RADIO INTERFACE</span>
        <span class="right"><%= user ? `${user.hertz} HZ` : 'PUBLIC BAND' %></span>
        <strong data-utc-clock>--:--:-- UTC</strong>
        <% if (user) { %><form method="post" action="/auth/logout" class="top-logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit">SIGN OUT</button></form><% } %>
      </header>
      <div class="display">
        <% if (internalFrequency) { %>
          <div class="internal-frequency-grid" aria-hidden="true" style="--if-cols:<%= internalFrequency.columns %>;--if-rows:<%= internalFrequency.rows %>">
            <% internalFrequency.cells.forEach((cell) => { %><i class="internal-frequency-cell" style="--if-fill:<%= cell.fill %>;--if-line:<%= cell.line %>;--if-dot:<%= cell.dot %>"></i><% }) %>
          </div>
        <% } %>
        <% if (flash) { %><div class="toast show flash-<%= flash.type %>" role="status"><%= flash.message %></div><% } %>
        <% if (organizerWarningRequired) { %>
          <section class="organizer-warning" role="dialog" aria-modal="true" aria-labelledby="organizer-warning-title">
            <div class="organizer-warning-panel">
              <p class="eyebrow">CQ / SECURE CHANNEL</p>
              <h1 id="organizer-warning-title">Now entering an encrypted frequency</h1>
              <p>You’re about to enter CQ’s internal organizer frequency. If you are screen sharing or recording, please stop before continuing. This area and its contents are confidential and covered by NDA.</p>
              <div class="organizer-warning-actions">
                <a class="button button-ghost" href="/app">Exit internal</a>
                <form method="post" action="/admin/session/verify"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-primary" type="submit">Verify session</button></form>
              </div>
            </div>
          </section>
        <% } %>
