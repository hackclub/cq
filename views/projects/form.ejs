<%- include('../partials/head') %>
<section id="main" class="screen-page app-screen">
  <header class="apphead"><div><span class="eyebrow"><%= editing ? 'PROJECT CHANNEL / EDIT' : 'NEW TRANSMISSION' %></span><h1><%= editing ? `Edit ${project.title}` : 'Create a project' %></h1></div><a class="button ghost headright" href="<%= editing ? `/app/projects/${project.id}` : '/app/projects' %>">Cancel</a></header>
  <div class="appbody split">
    <form method="post" action="<%= editing ? `/app/projects/${project.id}/edit` : '/app/projects/new' %>" class="formpane project-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if (errors.length) { %><div class="form-errors" role="alert"><strong>CHECK TRANSMISSION DATA</strong><ul><% errors.forEach((error) => { %><li><%= error %></li><% }) %></ul></div><% } %>
      <div class="notice">Projects must be directly related to amateur radio. Electronics, antennas, receivers, SDR experiments, digital modes, and radio software are all welcome.</div>
      <div class="field"><label>PROJECT TITLE</label><input name="title" value="<%= values.title || '' %>" required minlength="2" maxlength="80" placeholder="e.g. Portable APRS tracker"></div>
      <div class="field"><label>DESCRIPTION</label><textarea name="description" required minlength="20" maxlength="800" placeholder="What are you building?"><%= values.description || '' %></textarea></div>
      <div class="field"><label><%= values.track === 'software' ? 'PUBLIC GITHUB REPOSITORY' : 'PUBLIC GIT REPOSITORY' %></label><input type="url" name="repo_url" value="<%= values.repo_url || '' %>" required placeholder="https://github.com/you/project"><small class="field-help">Include a README and commits that show the build progressing.</small></div>
      <div class="formgrid">
        <div class="field"><label>PROJECT TRACK</label><select name="track" data-project-track><option value="hardware" <%= values.track !== 'software' ? 'selected' : '' %>>Electronics hardware</option><option value="software" <%= values.track === 'software' ? 'selected' : '' %>>Software</option></select></div>
        <div class="field"><label>PROJECT TYPE</label><select name="project_type" required><option value="">Choose one</option><% [['antenna','Antenna or feedline'],['radio-electronics','Radio electronics'],['sdr','Software-defined radio'],['digital-mode','Digital mode'],['satellite','Satellite or space radio'],['propagation','Propagation or RF analysis'],['station-tooling','Station software or tooling'],['other','Other ham-radio build']].forEach(([value,label]) => { %><option value="<%= value %>" <%= values.project_type === value ? 'selected' : '' %>><%= label %></option><% }) %></select></div>
      </div>
      <div class="field"><label>RADIO RELEVANCE</label><textarea name="radio_relevance" required minlength="40" maxlength="800" placeholder="How does this work with amateur radio?"><%= values.radio_relevance || '' %></textarea></div>
      <div class="formgrid"><div class="field"><label>COUNTRY OR TERRITORY</label><select name="country_code" required><option value="">Choose location</option><% countries.forEach((country) => { %><option value="<%= country.code %>" <%= values.country_code === country.code ? 'selected' : '' %>><%= country.name %></option><% }) %></select></div><div class="field"><label>LICENCE GOAL / OPTIONAL</label><input name="license_goal" value="<%= values.license_goal || '' %>" placeholder="Foundation licence"></div></div>
      <div class="formgrid"><div class="field"><label>CALLSIGN / WHEN ISSUED</label><input name="callsign" value="<%= values.callsign || '' %>" placeholder="VK7ABC"></div><div class="field"><label>TAGS / COMMA SEPARATED</label><input name="tags" value="<%= values.tags || '' %>" placeholder="antenna, satellites"></div></div>
      <div class="field"><label>AI STATEMENT / OPTIONAL</label><textarea name="ai_statement" maxlength="500" placeholder="What did AI help with, if anything?"><%= values.ai_statement || '' %></textarea></div>
      <% /* Hardware funding is assembled on the project page after design work is logged. */ %>

      <% const selectedHackatime = Array.isArray(values.hackatime_projects) ? values.hackatime_projects : String(values.hackatime_projects || '').split(',').map((value) => value.trim()).filter(Boolean); %>
      <div class="field"><label>HACKATIME PROJECTS</label>
        <% if (hackatime.connected && hackatime.projects.length) { %><details class="hackatime-picker"><summary><%= selectedHackatime.length ? `${selectedHackatime.length} project${selectedHackatime.length === 1 ? '' : 's'} selected` : 'Choose coding projects' %></summary><fieldset><% hackatime.projects.forEach((item) => { %><label class="hackatime-option"><input type="checkbox" name="hackatime_projects" value="<%= item.name %>" <%= selectedHackatime.includes(item.name) ? 'checked' : '' %>><span><strong><%= item.name %></strong><small><%= item.hours %> hours · <%= item.languages.slice(0,3).join(', ') %></small></span></label><% }) %></fieldset></details><button class="text-link" type="submit" formmethod="post" formaction="/app/hackatime/refresh" name="return_to" value="<%= editing ? `/app/projects/${project.id}/edit` : '/app/projects/new' %>">Refresh list</button>
        <% } else if (hackatime.configured && !hackatime.connected) { %><a class="button ghost" href="/app/hackatime/connect?return_to=<%= encodeURIComponent(editing ? `/app/projects/${project.id}/edit` : '/app/projects/new') %>">Connect Hackatime</a>
        <% } else { %><span class="field-help"><%= hackatime.connected ? 'No coding projects found.' : 'Hackatime is not connected. You can continue now.' %></span><% } %>
      </div>
      <div class="field thumbnail-upload" data-thumbnail-upload><label>PROJECT THUMBNAIL / ADD LATER</label><input type="hidden" name="thumbnail_url" value="<%= values.thumbnail_url || '' %>" data-thumbnail-url><input type="file" accept="image/jpeg,image/png,image/webp,image/gif" data-thumbnail-file hidden <%= imageUploadsConfigured ? '' : 'disabled' %>><button class="image-dropzone <%= imageUploadsConfigured ? '' : 'disabled' %>" type="button" data-thumbnail-choose <%= imageUploadsConfigured ? '' : 'disabled' %>><span class="dropzone-icon" aria-hidden="true">↑</span><strong>Choose a project image</strong><small>JPG, PNG, WebP or GIF · up to 8 MB</small></button><div class="upload-status" data-thumbnail-status><%= imageUploadsConfigured ? 'Optional until you ship the project.' : 'Organizer action needed: configure R2 uploads.' %></div><div class="upload-preview" data-thumbnail-preview><% if (values.thumbnail_url) { %><div class="upload-preview-item"><img src="<%= values.thumbnail_url %>" alt="Current project thumbnail"><button type="button" data-thumbnail-remove>Remove</button></div><% } %></div></div>
      <div class="field"><label>PUBLIC DEMO, DOWNLOAD OR VIDEO URL / ADD LATER</label><input type="url" name="demo_url" value="<%= values.demo_url || '' %>" placeholder="https://..."></div>
      <label class="checkbox-field"><input type="checkbox" name="is_update" value="1" <%= values.is_update ? 'checked' : '' %>> This is an update to an earlier ship</label>
      <div class="field"><label>UPDATE NOTE / IF APPLICABLE</label><textarea name="update_message" maxlength="2000"><%= values.update_message || '' %></textarea></div>
      <fieldset><legend>YSWS CONFIRMATIONS</legend><label class="checkbox-field"><input type="checkbox" name="original_work" value="1" <%= values.original_work ? 'checked' : '' %>> This is my original work, with reused work attributed</label><label class="checkbox-field"><input type="checkbox" name="not_school_assignment" value="1" <%= values.not_school_assignment ? 'checked' : '' %>> This was not made as a school assignment</label><label class="checkbox-field"><input type="checkbox" name="not_paid_hack_club_work" value="1" <%= values.not_paid_hack_club_work ? 'checked' : '' %>> This was not made as paid Hack Club work</label></fieldset>
      <div class="sticky-actions"><a class="button ghost" href="<%= editing ? `/app/projects/${project.id}` : '/app/projects' %>">Cancel</a><button class="button" type="submit"><%= editing ? 'Save project' : 'Create project' %></button></div>
    </form>
    <aside class="summary"><span class="label">TRANSMISSION CHECK</span><dl><div><dt>PROJECT</dt><dd><%= editing ? project.id : 'NOT SET' %></dd></div><div><dt>LOGGING</dt><dd>ENABLED</dd></div><div><dt>EARN RATE</dt><dd>5 Hz/hr</dd></div><div><dt>REVIEW</dt><dd>LOCAL CQ</dd></div></dl><p class="field-help">You can add a thumbnail and public demo before shipping.</p></aside>
  </div>
</section>
<%- include('../partials/footer') %>
