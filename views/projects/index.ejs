<%- include('../partials/head') %>
<main id="main" class="app-main shell">
  <div class="page-heading">
    <div><p class="eyebrow">Your workshop</p><h1>Projects</h1><p>Every radio build, work log, and project review in one place.</p></div>
    <a class="button button-primary" href="/app/projects/new">+ New project</a>
  </div>
  <% if (!projects.length) { %>
    <div class="panel empty-state"><img src="/assets/antenna_img.png" alt=""><h2>Start your first signal.</h2><p>Build a listening setup, antenna, APRS tracker, RF circuit, SDR experiment, or ham-radio software tool. Studying alone does not count.</p><a class="button button-primary" href="/app/projects/new">Create a project</a></div>
  <% } else { %>
    <div class="project-card-grid">
      <% projects.forEach((project) => { %>
        <a class="project-card" href="/app/projects/<%= project.id %>">
          <div class="project-card-top"><span class="status-pill status-<%= project.status %>"><%= statusLabel(project.status) %></span><span><%= project.track %></span></div>
          <h2><%= project.title %></h2>
          <p><%= project.description %></p>
          <div class="progress"><span style="width: <%= project.milestonesTotal ? Math.round(project.milestonesDone / project.milestonesTotal * 100) : 0 %>%"></span></div>
          <div class="project-card-foot"><span><%= project.milestonesDone %>/<%= project.milestonesTotal %> milestones</span><span><%= Math.round(project.journalMinutes / 6) / 10 %>h logged</span></div>
        </a>
      <% }) %>
    </div>
  <% } %>
</main>
<%- include('../partials/footer') %>
